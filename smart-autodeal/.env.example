# Local development (works with docker-compose.yml). On Hostinger set these in hPanel → Environment variables.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=autodeal
DB_USER=autodeal
DB_PASSWORD=autodealpass
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
SUPER_USERNAME=super
SUPER_PASSWORD=super12345
SUPPORT_PHONE=9822000000
PORT=3000
# Android app (APK / Play Store) – optional, see docs/ANDROID-APP.md
ANDROID_PACKAGE=
ANDROID_SHA256=
# RC details from number plate – optional. RC_PROVIDER = surepass | generic | mock (mock = fake data, never in production)
# surepass: only RC_API_KEY needed. generic: RC_API_URL + RC_API_KEY (+ RC_API_KEY_HEADER, RC_API_FIELD). See docs/RC-LOOKUP.md
RC_PROVIDER=
RC_API_KEY=
RC_API_URL=
